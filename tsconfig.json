{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023"],

    // Decorators (obrigatório pro Nest)
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // Interop / imports
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    // Output
    "outDir": "./dist",
    "baseUrl": "./",
    "declaration": true,
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,

    // Strictness — escolha UM estilo, não misture
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,

    // Performance / compat
    "skipLibCheck": true,
    "isolatedModules": true,

    "ignoreDeprecations": "6.0",

    "types": ["jest", "node"]
  }
}
